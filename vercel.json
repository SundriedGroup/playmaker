{
  "functions": {
    "api/dashboard.js": { "maxDuration": 30 },
    "api/snapshot.js": { "maxDuration": 60 },
    "api/content.js": { "maxDuration": 15 }
  },
  "crons": [
    { "path": "/api/snapshot", "schedule": "0 4 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
